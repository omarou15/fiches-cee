{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/schemas/dossier_cee.schema.json",
  "title": "Dossier CEE unifie",
  "description": "Representation pivot utilisee par les validateurs devis, facture, note de dimensionnement, DPT et controle PNCEE.",
  "type": "object",
  "required": ["fiche_code"],
  "properties": {
    "operation_id": { "type": ["string", "null"] },
    "fiche_code": { "type": "string" },
    "operation_type": { "type": ["string", "null"], "enum": ["standardized", "specific", "programme", "standardisee", "specifique", null] },
    "validation_mode": { "type": ["string", "null"], "enum": ["advisory", "draft", "strict", null] },
    "dossier": { "type": "object", "additionalProperties": true },
    "beneficiary": { "type": "object", "additionalProperties": true },
    "client": { "type": "object", "additionalProperties": true },
    "company": { "type": "object", "additionalProperties": true },
    "professional": { "type": "object", "additionalProperties": true },
    "site": { "type": "object", "additionalProperties": true },
    "operation": { "type": "object", "additionalProperties": true },
    "quote": { "type": "object", "additionalProperties": true },
    "invoice": { "type": "object", "additionalProperties": true },
    "cadre_contribution": { "type": "object", "additionalProperties": true },
    "documents": { "type": ["object", "array"], "additionalProperties": true },
    "calculation": { "type": "object", "additionalProperties": true },
    "technical": { "type": "object", "additionalProperties": true },
    "building": { "type": "object", "additionalProperties": true },
    "climate": { "type": "object", "additionalProperties": true },
    "generator": { "type": "object", "additionalProperties": true },
    "boiler_room": { "type": "object", "additionalProperties": true },
    "dpt": { "type": "object", "additionalProperties": true },
    "date_cadre_contribution": { "type": ["string", "null"] },
    "date_engagement": { "type": ["string", "null"] },
    "date_debut_travaux": { "type": ["string", "null"] },
    "date_facture": { "type": ["string", "null"] },
    "date_ah_signee": { "type": ["string", "null"] },
    "date_depot_pncee": { "type": ["string", "null"] },
    "qualification_rge_validite": { "type": ["string", "null"] },
    "flags": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
