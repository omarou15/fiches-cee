{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/schemas/fiche_cee.schema.json",
  "title": "Fiche CEE normalisee",
  "type": "object",
  "required": ["code", "sector", "family", "title", "source_files", "extraction"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^(AGRI|BAR|BAT|IND|RES|TRA)-[A-Z]+-[0-9]+$"
    },
    "sector": {
      "type": "string",
      "enum": ["agriculture", "residentiel", "tertiaire", "industrie", "reseaux", "transport"]
    },
    "title": {
      "type": "string"
    },
    "title_clean": {
      "type": ["string", "null"]
    },
    "application_sector": {
      "type": ["string", "null"]
    },
    "operation_description": {
      "type": ["string", "null"]
    },
    "eligible_uses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excluded_uses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "non_cumulation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": ["string", "null"] },
          "condition": { "type": "string" },
          "source_file": { "type": ["string", "null"] },
          "page": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    },
    "family": {
      "type": "string"
    },
    "version": {
      "type": ["string", "null"]
    },
    "document_version": {
      "type": ["string", "null"]
    },
    "effective_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "validity": {
      "type": "object",
      "properties": {
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "engagement_deadline": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },
    "dates": {
      "type": "object",
      "properties": {
        "arrete_date": { "type": ["string", "null"], "format": "date" },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "partie_a_effective_date": { "type": ["string", "null"], "format": "date" },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "date_source": {
          "type": "string",
          "enum": ["filename", "document_text", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": ["object", "string", "null"],
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title", "text"],
        "properties": {
          "number": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "page_start": { "type": ["integer", "null"] },
          "page_end": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "null"] }
    },
    "systems": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "null"] }
    },
    "eligibility_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "technical_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "technical_requirements_structured": {
      "type": "object",
      "additionalProperties": true
    },
    "dimensioning_study": {
      "type": "object",
      "additionalProperties": true
    },
    "proof_of_completion": {
      "type": "object",
      "additionalProperties": true
    },
    "specific_supporting_documents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_documents": {
      "anyOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/text_item" }
        },
        {
          "$ref": "#/$defs/required_documents_structured"
        }
      ]
    },
    "attestation_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "control_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "calculation": {
      "type": ["object", "null"],
      "properties": {
        "formula_text": { "type": ["string", "null"] },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/variable" }
        },
        "tables": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "formulas": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "bonifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "site_data_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/site_data_requirement" }
    },
    "output_documents": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "null"] }
    },
    "compliance_risks": {
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/compliance_risk" },
          { "type": "string" }
        ]
      }
    },
    "lifetime_years": {
      "type": ["integer", "null"]
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "document_type", "path"],
        "properties": {
          "document_id": { "type": "string" },
          "code": { "type": ["string", "null"] },
          "document_type": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "path": { "type": "string" },
          "source_url": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "effective_date": { "type": ["string", "null"], "format": "date" },
          "metadata": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "extraction": {
      "$ref": "#/$defs/extraction_meta"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text_item": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "source_file": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "section_title": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "medium"
        }
      },
      "additionalProperties": false
    },
    "site_data_requirement": {
      "type": "object",
      "required": ["field", "required"],
      "properties": {
        "field": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "source_file": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "value_type": {
          "type": "string",
          "enum": ["number", "string", "boolean", "enum", "unknown"],
          "default": "unknown"
        },
        "values": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean", "null"] }
        },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["risk", "severity"],
      "properties": {
        "risk": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "source_file": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "compliance_risk": {
      "type": "object",
      "required": ["text", "severity"],
      "properties": {
        "text": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "required_document_item": {
      "type": "object",
      "required": ["document"],
      "properties": {
        "document": { "type": ["string", "null"] },
        "timing": { "type": ["string", "null"] },
        "obligatoire": { "type": ["boolean", "string", "null"] },
        "source": { "type": ["string", "null"] },
        "source_file": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "section_title": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "confidence": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", null]
        },
        "needs_human_review": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "required_documents_structured": {
      "type": "object",
      "required": ["common_pieces_annexe5", "specific_pieces_fiche", "pieces_precarite", "pieces_coup_de_pouce"],
      "properties": {
        "common_pieces_annexe5": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_document_item" }
        },
        "specific_pieces_fiche": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_document_item" }
        },
        "pieces_precarite": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_document_item" }
        },
        "pieces_coup_de_pouce": {
          "type": "array",
          "items": { "$ref": "#/$defs/required_document_item" }
        }
      },
      "additionalProperties": false
    },
    "extraction_meta": {
      "type": "object",
      "required": ["status", "needs_human_review"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "extracted", "needs_review", "validated", "failed"]
        },
        "tool": { "type": ["string", "null"] },
        "extracted_at": { "type": ["string", "null"], "format": "date-time" },
        "needs_human_review": { "type": "boolean" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
