{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/schemas/fiche_cee.schema.json",
  "title": "Fiche CEE normalisee",
  "type": "object",
  "required": ["code", "sector", "title", "source_files", "extraction"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^(AGRI|BAR|BAT|IND|RES|TRA)-[A-Z]+-[0-9]+$"
    },
    "sector": {
      "type": "string",
      "enum": ["agriculture", "residentiel", "tertiaire", "industrie", "reseaux", "transport"]
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": ["string", "null"]
    },
    "effective_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "scope": {
      "type": ["string", "null"]
    },
    "eligibility_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "technical_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "required_documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "attestation_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "control_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "calculation": {
      "type": ["object", "null"],
      "properties": {
        "formula_text": { "type": ["string", "null"] },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/variable" }
        },
        "tables": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "bonifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_item" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "related_documents": {
      "type": "array",
      "items": { "$ref": "document_cee.schema.json" }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "extraction": {
      "$ref": "#/$defs/extraction_meta"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text_item": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "source_file": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "medium"
        }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "value_type": {
          "type": "string",
          "enum": ["number", "string", "boolean", "enum", "unknown"],
          "default": "unknown"
        },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["risk", "severity"],
      "properties": {
        "risk": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "source_file": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "extraction_meta": {
      "type": "object",
      "required": ["status", "needs_human_review"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "extracted", "needs_review", "validated", "failed"]
        },
        "tool": { "type": ["string", "null"] },
        "extracted_at": { "type": ["string", "null"], "format": "date-time" },
        "needs_human_review": { "type": "boolean" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
