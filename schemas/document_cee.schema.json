{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/schemas/document_cee.schema.json",
  "title": "Document CEE",
  "type": "object",
  "required": ["document_id", "document_type", "path"],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "code": {
      "type": ["string", "null"],
      "pattern": "^(AGRI|BAR|BAT|IND|RES|TRA)-[A-Z]+-[0-9]+$"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "fiche_principale",
        "partie_a",
        "annexe",
        "feuille_recapitulative",
        "question_reponse",
        "coup_de_pouce",
        "texte_reglementaire",
        "guide",
        "programme",
        "statistique",
        "page_reference",
        "other"
      ]
    },
    "title": {
      "type": ["string", "null"]
    },
    "path": {
      "type": "string"
    },
    "source_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "format": {
      "type": ["string", "null"],
      "enum": ["pdf", "xlsx", "xls", "docx", "doc", "html", "txt", "zip", null]
    },
    "effective_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
