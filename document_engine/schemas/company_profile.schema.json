{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/document_engine/schemas/company_profile.schema.json",
  "title": "Generic company profile",
  "type": "object",
  "required": ["company_name", "siret", "address", "email", "signatory", "branding"],
  "properties": {
    "company_name": { "type": "string" },
    "siret": { "type": "string" },
    "address": { "type": "string" },
    "email": { "type": "string" },
    "phone": { "type": ["string", "null"] },
    "logo": { "type": ["string", "null"] },
    "signatory": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "primary_color": { "type": "string" },
        "secondary_color": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
