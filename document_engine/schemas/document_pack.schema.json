{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/document_engine/schemas/document_pack.schema.json",
  "title": "Generated document pack manifest",
  "type": "object",
  "required": ["case_id", "code", "mode", "files"],
  "properties": {
    "case_id": { "type": "string" },
    "code": { "type": "string" },
    "mode": { "type": "string", "enum": ["draft", "strict"] },
    "source_type": { "type": "string", "enum": ["operation_input", "inferred_project"] },
    "files": { "type": "array", "items": { "type": "string" } },
    "blocking_points": { "type": "array", "items": { "type": "string" } },
    "missing_documents": { "type": "array", "items": { "type": "string" } },
    "non_compliant_documents": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
