{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/document_engine/schemas/operation_input.schema.json",
  "title": "CEE document engine operation input",
  "type": "object",
  "required": ["operation", "client", "site", "technical", "calculation", "quote", "invoice", "documents", "compliance"],
  "properties": {
    "operation": {
      "type": "object",
      "required": ["case_id", "cee_code", "description", "engagement_date"],
      "properties": {
        "case_id": { "type": "string" },
        "cee_code": { "type": "string" },
        "description": { "type": "string" },
        "engagement_date": { "type": "string" },
        "completion_date": { "type": ["string", "null"] },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "client": {
      "type": "object",
      "required": ["name", "address"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "contact_name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "address": { "type": "string" }
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["address", "postal_code", "city", "climate_zone"],
      "properties": {
        "address": { "type": "string" },
        "postal_code": { "type": "string" },
        "city": { "type": "string" },
        "climate_zone": { "type": "string" },
        "building_type": { "type": "string" },
        "apartments_count": { "type": ["number", "integer", "null"] },
        "heated_surface_m2": { "type": ["number", "integer", "null"] }
      },
      "additionalProperties": true
    },
    "technical": { "type": "object", "additionalProperties": true },
    "calculation": { "type": "object", "required": ["total_kwh_cumac"], "additionalProperties": true },
    "quote": {
      "type": "object",
      "required": ["number", "date", "total_ht", "total_ttc", "lines"],
      "properties": {
        "number": { "type": "string" },
        "date": { "type": "string" },
        "valid_until": { "type": ["string", "null"] },
        "total_ht": { "type": ["number", "integer", "null"] },
        "total_ttc": { "type": ["number", "integer", "null"] },
        "status": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "invoice": {
      "type": "object",
      "required": ["number", "date", "total_ht", "total_ttc"],
      "properties": {
        "number": { "type": "string" },
        "date": { "type": "string" },
        "due_date": { "type": ["string", "null"] },
        "total_ht": { "type": ["number", "integer", "null"] },
        "total_ttc": { "type": ["number", "integer", "null"] },
        "status": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "object",
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "non_compliant": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "compliance": {
      "type": "object",
      "properties": {
        "eligibility_status": { "type": "string" },
        "blocking_points": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "mail": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
