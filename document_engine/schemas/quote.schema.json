{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/document_engine/schemas/quote.schema.json",
  "title": "Draft quote",
  "type": "object",
  "required": ["number", "date", "total_ht", "total_ttc", "status", "lines"],
  "properties": {
    "number": { "type": "string" },
    "date": { "type": "string" },
    "valid_until": { "type": ["string", "null"] },
    "total_ht": { "type": ["number", "integer", "null"] },
    "total_ttc": { "type": ["number", "integer", "null"] },
    "status": { "type": "string" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price_ht", "total_ht"],
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": ["number", "integer"] },
          "unit": { "type": ["string", "null"] },
          "unit_price_ht": { "type": ["number", "integer", "null"] },
          "total_ht": { "type": ["number", "integer", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
