{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/inference_engine/schemas/pricebook.schema.json",
  "title": "Generic editable pricebook",
  "type": "object",
  "required": ["name", "currency", "items"],
  "properties": {
    "name": { "type": "string" },
    "currency": { "type": "string" },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "label", "unit", "price_ht_min", "price_ht_typical", "price_ht_max", "conditions", "confidence", "notes"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "price_ht_min": { "type": ["number", "integer"] },
          "price_ht_typical": { "type": ["number", "integer"] },
          "price_ht_max": { "type": ["number", "integer"] },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
