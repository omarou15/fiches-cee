{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarou15/fiches-cee/inference_engine/schemas/minimal_case_input.schema.json",
  "title": "Minimal CEE case input",
  "type": "object",
  "required": ["case_id", "target_code", "client", "site", "visit", "objective"],
  "properties": {
    "case_id": { "type": "string" },
    "target_code": { "type": "string" },
    "client": {
      "type": "object",
      "required": ["name", "address"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "contact_email": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "type": "string" },
        "postal_code": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "visit": {
      "type": "object",
      "required": ["notes"],
      "properties": {
        "notes": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path_or_label", "status"],
        "properties": {
          "type": { "type": "string" },
          "path_or_label": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "missing", "unknown"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "objective": {
      "type": "object",
      "required": ["cee_code", "description"],
      "properties": {
        "cee_code": { "type": "string" },
        "description": { "type": "string" },
        "generation_mode": { "type": "string", "enum": ["draft", "strict"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
